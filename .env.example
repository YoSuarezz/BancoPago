# Copia este archivo como .env y ajusta los valores según tu entorno local.
# El .env real nunca debe subirse al repositorio (está en .gitignore).

# Base de datos PostgreSQL
DB_USER=bancopago
DB_PASSWORD=bancopago_dev_password
R2DBC_URL=r2dbc:postgresql://localhost:5433/bancopago_db
FLYWAY_URL=jdbc:postgresql://localhost:5433/bancopago_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
